{
  "name": "footballay-db-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "tsx src/cli.ts db:up",
    "db:down": "tsx src/cli.ts db:down",
    "db:migrate": "tsx src/cli.ts db:migrate",
    "db:reset": "tsx src/cli.ts db:reset",
    "seed:realistic": "tsx src/cli.ts seed --preset realistic",
    "seed:scale": "tsx src/cli.ts seed",
    "seed": "tsx src/cli.ts seed",
    "validate": "tsx src/cli.ts validate",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:integration": "tsx --test test/integration/*.test.ts"
  },
  "dependencies": { "pg": "8.16.3", "pg-copy-streams": "7.0.0" },
  "devDependencies": { "@types/node": "22.15.30", "@types/pg": "8.15.5", "@types/pg-copy-streams": "1.2.5", "tsx": "4.20.5", "typescript": "5.9.2" }
}
